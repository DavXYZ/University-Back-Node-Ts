{
  "compilerOptions": {
    "typeRoots": ["node_modules/@types", "v/types"],
    "lib": ["ES6"],
    "module": "CommonJS",
    "target": "ES6",
    "esModuleInterop": true,
    "moduleResolution": "node",
    "outDir": "./dist",
    "rootDir": "./",  // Update this to the root of your project
    "strict": true,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*.ts", "v/types/**/*.d.ts"],  // Update this to the correct path
  "exclude": ["node_modules", "**/*.spec.ts"]
}
